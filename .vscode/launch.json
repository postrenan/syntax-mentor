{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (Syntax Mentor)",
      "type": "extensionDevelopmentHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
